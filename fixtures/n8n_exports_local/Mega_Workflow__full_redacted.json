      "credentials": null,
      "parameters": {
        "jsonSchemaExample": "{\n  \"subject\": \"Following Up On Your Inquiry - Prowave Consultants\",\n  \"body\": \"Dear Aditya,\\n\\nThank you for your interest. Our sales team will contact you shortly.\\n\\nRegards,\\nProwave Consultants\"\n}"
