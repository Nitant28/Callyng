    {
      "name": "Generate Follow-up Email",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "disabled": false,
      "credentials": null,
      "parameters": {
        "promptType": "define",
        "text": "=You are an email assistant for Aakashvani.\n\nGenerate a professional follow-up email for a lead after an AI voice call.\n\nUse the provided lead information.\n\nRules:\n- Write a clear subject.\n- Write a friendly and professional email.\n- Mention the customer's preferences naturally.\n- Thank the customer for their time.\n- Tell them that a representative will contact them shortly.\n- Do not invent information.\nReturn only valid JSON.\nDo not wrap it inside markdown.\nDo not add ```json.\nThe response must have exactly these keys:\n\n{\n \"subject\": \"\",\n \"body\": \"\"\n}\n\nUse the following information:\n\n\nLead Name: {{ $json.name }}\nClient Name: {{ $json.client_name }}\nSummary: {{ $json.summary }}\nBHK Preference: {{ $json.bhk_preference }}\nLocation Preference: {{ $json.location_preference }}\nBudget: {{ $json.budget }}\n\nReturn ONLY valid JSON.\n\nDo NOT wrap the response inside ```json.\nDo NOT include markdown.\nDo NOT use placeholders like [Lead Name].\nUse the actual values provided.",
        "hasOutputParser": true,
        "options": {}
      },
      "position": [
        224,
        112
      ]
    },
