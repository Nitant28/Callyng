# =============================================================================
# AAKASHVANI — Environment Configuration
# Copy to .env and fill in values. Lines marked REQUIRED must be set.
# Lines marked OPTIONAL can be left blank to disable that feature.
# =============================================================================

# ── SERVER ────────────────────────────────────────────────────────────────────
# Public URL ngrok assigns to your tunnel. Used by Plivo to reach /answer, /ws, and /plivo-hangup.
# REQUIRED for making real calls.
NGROK_URL=https://your-reserved-domain.ngrok-free.app

# When callee hangs up (Plivo HangupSource=Callee), schedule callback_scheduled using
# campaign.retry_delay_minutes. Set false to disable without code changes.
PLIVO_HANGUP_CALLBACK_ENABLED=true

# ── DATABASE ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. REQUIRED for Phase 2 multi-tenant features.
# Leave blank to run Phase 0 single-tenant mode with SQLite only.
DATABASE_URL=postgresql://aakashvani:devpassword@localhost:5432/aakashvani
REDIS_URL=redis://localhost:6379/0
DB_POOL_MIN=5
DB_POOL_MAX=50
# SQLite fallback (Phase 0 / bot testing). Always active regardless of DATABASE_URL.
CALL_LOG_DB_PATH=./data/call_logs.db

# ── ADMIN ─────────────────────────────────────────────────────────────────────
# Secret key for /internal/* admin endpoints. Generate with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# REQUIRED if using Phase 2 admin API. Never expose publicly.
ADMIN_API_KEY=

# ── BOT ROUTING (Phase 0 / local dev fallback) ────────────────────────────────
# Used by `just dev`, `just call` when no campaign/bot_config is involved.
BOT_ROUTE=sts

STS_SCRIPT=pyramid_mr
CASCADE_SCRIPT=prowave

# ── TELEPHONY ─────────────────────────────────────────────────────────────────
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=
# Dialer pauses when cash_credits falls below this USD amount (default 0.50)
PLIVO_MIN_BALANCE_USD=0.50
# How often to re-check Plivo balance during a running campaign (seconds)
PLIVO_BALANCE_CACHE_SECONDS=30

# Finalize call_logs left in_progress (global sweep at startup + every N seconds)
STALE_CALL_LOG_SWEEP_ENABLED=true
STALE_CALL_LOG_SWEEP_SECONDS=300

# ── AI PROVIDERS ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GROQ_API_KEY=
SARVAM_API_KEY=
CARTESIA_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_VOICE_ID=
OPENAI_API_KEY=

POST_CALL_MODEL=llama-3.3-70b-versatile

# OPTIONAL: STS approximate cost in INR
# GEMINI_LIVE_INPUT_USD_PER_1M=
# GEMINI_LIVE_OUTPUT_USD_PER_1M=
USD_INR=84.0

# ── PIPELINE TUNING ───────────────────────────────────────────────────────────
MAX_CALL_MINUTES=10
GEMINI_CONTEXT_COMPRESSION=1
GEMINI_CWC_TRIGGER_TOKENS=20000

# ── WEBHOOKS ──────────────────────────────────────────────────────────────────
# Phase 0 single-client n8n webhook URL.
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=
# N8N_WEBHOOK_TIMEOUT_S=30

# Public URL Plivo uses for /answer (MUST be ngrok — not localhost). Defaults to NGROK_URL.
# DIALER_CALLBACK_HOST=https://your-subdomain.ngrok-free.app

# ── PAYMENTS (Phase 3 — not needed yet) ───────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── STORAGE (Phase 4 — not needed yet) ────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aakashvani-recordings
