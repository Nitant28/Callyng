# ── Telephony (Plivo) ────────────────────────────────────────────────────────
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

# ── LLMs / speech ────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
SARVAM_API_KEY=
OPENAI_API_KEY=

# Post-call transcript → structured JSON (Groq chat/completions). Uses GROQ_API_KEY.
# Omit GROQ_API_KEY to skip extraction. Model defaults to llama-3.3-70b-versatile.
POST_CALL_MODEL=llama-3.3-70b-versatile

# STS (Gemini Live) approximate cost in INR — optional. Set both token rates from
# Google’s pricing for your model (USD per 1M tokens). USD_INR is FX for display only.
# GEMINI_LIVE_INPUT_USD_PER_1M=
# GEMINI_LIVE_OUTPUT_USD_PER_1M=
USD_INR=85

# After each call: JSON POST to this n8n workflow webhook URL (test URL from n8n).
# N8N_WEBHOOK_URL=
# Optional shared secret; sent as X-Webhook-Secret (verify in n8n).
# N8N_WEBHOOK_SECRET=
# Optional HTTP timeout in seconds (default 30).
# N8N_WEBHOOK_TIMEOUT_S=30

# ── Database (PostgreSQL 16 via docker compose) ─────────────────────────────
# Start: just db-up && just db-migrate && just db-seed
DATABASE_URL=postgresql://aakashvani:devpassword@localhost:5432/aakashvani

# Admin API key for /internal/* routes (Phase 2A). Generate a long random secret.
ADMIN_API_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
ENV=local

# Pipecat Cloud deployment metadata (only used when ENV=production)
AGENT_NAME=aakashvani
ORGANIZATION_NAME=

# ── Bot ──────────────────────────────────────────────────────────────────────
# Which pipeline to use: 'sts' (Gemini Live speech-to-speech) or 'cascade'
# (Sarvam STT + Groq LLM + Cartesia TTS). Loaded by server.py at module load.
BOT_ROUTE=sts

# STS Gemini Live: context window compression (long calls). GEMINI_CONTEXT_COMPRESSION=0 disables.
# GEMINI_CWC_TRIGGER_TOKENS: compress when context exceeds this (default 20000); API retains ~half.
# GEMINI_CWC_TRIGGER_TOKENS=20000
# GEMINI_CONTEXT_COMPRESSION=1

# STS: which module under sts_scripts/ to load (snake_case file name without .py)
STS_SCRIPT=pyramid_mr

# Cascade: which module under cascade_scripts/ to load
CASCADE_SCRIPT=prowave

# Per-call transcript + metadata SQLite file (stdlib sqlite3). Parent dirs created at startup.
CALL_LOG_DB_PATH=./data/call_logs.db

# Hard cap on connected call length (minutes). Default 10. Set to 0 to disable only the
# watchdog timer; LLM ``end_call`` tool still applies on cascade and STS.
MAX_CALL_MINUTES=10

# STS only: if the model speaks a scripted terminal goodbye but omits ``end_call``,
# hang up after GOODBYE_HANGUP_DELAY_S (substring match on assistant text). GOODBYE_HANGUP_ENABLE=0 disables.
GOODBYE_HANGUP_ENABLE=1
GOODBYE_HANGUP_DELAY_S=2

# Injected by server WebSocket only — UUID from POST /start; do not set manually.
# _session_call_id=

# ── Dev tunneling ────────────────────────────────────────────────────────────
# Reserved ngrok domain. Used by `just call` and `scripts/call.sh` to know
# where to POST /start.
NGROK_URL=https://your-subdomain.ngrok-free.dev
