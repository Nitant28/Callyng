# =============================================================================
# AAKASHVANI — Environment Configuration
# Copy to .env and fill in values. Lines marked REQUIRED must be set.
# Lines marked OPTIONAL can be left blank to disable that feature.
# =============================================================================

# ── ENVIRONMENT & SERVER ──────────────────────────────────────────────────────
# Environment mode: 'production' or 'local'
ENV=production

# Public URL ngrok or domain assigns. Used by Plivo to reach /answer, /ws, and /plivo-hangup.
# In production, set to your backend domain (e.g. https://api.yourdomain.com).
# REQUIRED for making real calls.
NGROK_URL=https://api.yourdomain.com

# When callee hangs up (Plivo HangupSource=Callee), schedule callback_scheduled using
# campaign.retry_delay_minutes. Set false to disable without code changes.
PLIVO_HANGUP_CALLBACK_ENABLED=true

# Structured JSON logging in production (json | text)
LOG_FORMAT=json

# ── DATABASE & REDIS ──────────────────────────────────────────────────────────
# Passwords used by Docker Compose for postgres and redis containers
POSTGRES_PASSWORD=your_strong_postgres_password_here
REDIS_PASSWORD=your_strong_redis_password_here

# Connection strings
DATABASE_URL=postgresql://aakashvani:your_strong_postgres_password_here@localhost:5432/aakashvani
REDIS_URL=redis://:your_strong_redis_password_here@localhost:6379/0
DB_POOL_MIN=5
DB_POOL_MAX=50

# SQLite fallback (Phase 0 / bot testing). Always active regardless of DATABASE_URL.
CALL_LOG_DB_PATH=./data/call_logs.db

# ── ADMIN ─────────────────────────────────────────────────────────────────────
# Secret key for /internal/* admin endpoints. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# REQUIRED if using Phase 2 admin API. Never expose publicly.
ADMIN_API_KEY=

# ── BOT ROUTING (Phase 0 / fallback default) ──────────────────────────────────
# Used when no campaign/bot_config is involved ('sts' or 'cascaded').
BOT_ROUTE=sts

STS_SCRIPT=pyramid_bilingual
CASCADE_SCRIPT=prowave

# ── TELEPHONY (Plivo) ─────────────────────────────────────────────────────────
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=
# Dialer pauses when cash_credits falls below this USD amount (default 0.50)
PLIVO_MIN_BALANCE_USD=0.50
# How often to re-check Plivo balance during a running campaign (seconds)
PLIVO_BALANCE_CACHE_SECONDS=30

# Finalize call_logs left in_progress (global sweep at startup + every N seconds)
STALE_CALL_LOG_SWEEP_ENABLED=true
STALE_CALL_LOG_SWEEP_SECONDS=300

# ── AI PROVIDERS ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GROQ_API_KEY=
SARVAM_API_KEY=
CARTESIA_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=sk_786c46f20243da3d821884492b0f17b05b2d1c7b40ce2bbc
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=
SONIOX_API_KEY=e21ece3a426186f0d76efdfafd25a6dd406c3573c2d99b3fc21734b1ab63be8b
# Recommended Hindi default: c1abd502-9231-4558-a054-10ac950c356d (Hindi Narrator Woman)
CARTESIA_VOICE_ID=
SARVAM_TTS_SPEAKER=shubh
SONIOX_TTS_VOICE=
# ANTHROPIC_API_KEY=

# Post-call extraction provider: openai | anthropic | gemini (default openai).
POST_CALL_PROVIDER=openai
POST_CALL_MODEL=openai/gpt-oss-120b
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OPTIONAL: STS approximate cost in INR
# GEMINI_LIVE_INPUT_USD_PER_1M=
# GEMINI_LIVE_OUTPUT_USD_PER_1M=
USD_INR=84.0

# OPTIONAL: cascade COGS in USD (internal; not shown to clients).
# Uncomment and set rates for the providers you run. Unset = that component is $0
# when any other rate is set; if none are set, cost_usd stays NULL.
# STT_SARVAM_USD_PER_MIN=
# STT_SONIOX_USD_PER_MIN=
# STT_ELEVENLABS_USD_PER_MIN=
# STT_DEEPGRAM_USD_PER_MIN=
# LLM_GROQ_INPUT_USD_PER_1M=
# LLM_GROQ_OUTPUT_USD_PER_1M=
# LLM_OPENAI_INPUT_USD_PER_1M=
# LLM_OPENAI_OUTPUT_USD_PER_1M=
# LLM_GOOGLE_INPUT_USD_PER_1M=
# LLM_GOOGLE_OUTPUT_USD_PER_1M=
# TTS_CARTESIA_USD_PER_1K_CHARS=
# TTS_ELEVENLABS_USD_PER_1K_CHARS=
# TTS_DEEPGRAM_USD_PER_1K_CHARS=
# TTS_SARVAM_USD_PER_1K_CHARS=
# TTS_SONIOX_USD_PER_1K_CHARS=

# ── PIPELINE TUNING ───────────────────────────────────────────────────────────
MAX_CALL_MINUTES=10
SILENCE_TIMEOUT_SECONDS=45
GEMINI_CONTEXT_COMPRESSION=1
GEMINI_CWC_TRIGGER_TOKENS=20000

# ── N8N WORKFLOW AUTOMATION ───────────────────────────────────────────────────
# Remote production n8n (hosted separately — NOT local Docker).
# Local editor: http://localhost:5678  |  Production: https://n8n.bhuvisx.com
# N8N_BASE_URL=https://n8n.bhuvisx.com
# N8N_LEAD_WEBHOOK_URL=https://n8n.bhuvisx.com/webhook/5879f520-d9b9-4dc9-ba95-3392c2f30792
# N8N_FOLLOWUP_WEBHOOK_URL=   # Optional alias if N8N_LEAD_WEBHOOK_URL is unset
# N8N_WEBHOOK_SECRET=     # Shared secret sent as X-Aakashvani-Webhook-Secret
# N8N_TIMEOUT_SECONDS=15
# N8N_EMAIL=
# N8N_PASSWORD=
# N8N_WF_ID=
# Permanent public API URL n8n uses for /internal/messages/record and /internal/leads/context.
# Required in production. NGROK_URL is a local-dev fallback only (ignored when ENV=production).
# AAKASHVANI_PUBLIC_URL=https://api.your-domain.com
# AAKASHVANI_PUBLIC_URL=https://api.your-domain.com  # alias of AAKASHVANI_PUBLIC_URL

# Legacy Phase 0 global fallback (optional)
# N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/your-id
# N8N_WEBHOOK_TIMEOUT_S=30

# Master encryption key for n8n credentials at rest (if self-hosting n8n).
# Generate once with: openssl rand -hex 24
N8N_ENCRYPTION_KEY=

# ── WHATSAPP (Meta Cloud via Aakashvani Provider Manager) ─────────────────────
# Prefer configuring tokens in Admin → WhatsApp integrations (encrypted in DB).
# These env placeholders document Meta concepts — do NOT put real tokens in git.
# WHATSAPP_CREDENTIALS_KEY=   # Optional; defaults to ADMIN_API_KEY for credential encryption
# WHATSAPP_PHONE_NUMBER_ID=   # Meta Phone Number ID (NOT the WABA ID) — configure in Admin UI
# WHATSAPP_BUSINESS_ACCOUNT_ID=  # WABA ID — configure in Admin UI / n8n WhatsApp credential
# WHATSAPP_ACCESS_TOKEN=      # System user token — Admin UI write-only / n8n credential
# WHATSAPP_VERIFY_TOKEN=      # Webhook verify token — Admin UI / Meta App Dashboard
# WHATSAPP_API_VERSION=v21.0  # Graph API version used by MetaCloudProvider

# n8n-managed credentials (configure inside n8n; not in this .env):
# - Google Gemini (PaLM) API
# - Gmail OAuth2
# - Google Sheets OAuth2
# - WhatsApp OAuth / access token + Business Account ID (WABA)
#
# n8n environment variables (set in n8n Settings → Variables, NOT in git):
# AAKASHVANI_PUBLIC_URL=https://your-api-host
# AAKASHVANI_ADMIN_KEY= same value as ADMIN_API_KEY above

# Public URL Plivo uses for /answer (defaults to NGROK_URL)
# DIALER_CALLBACK_HOST=https://api.yourdomain.com

# ── STORAGE (Recordings) ──────────────────────────────────────────────────────
# Storage type: 'r2' or 'local'
RECORDING_STORAGE=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aakashvani-recordings

# ── PAYMENTS (Razorpay — optional/future) ────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

